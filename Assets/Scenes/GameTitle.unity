  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\uC880\uBE44\uB85C \uAC00\uB4DD\uD55C \uC138\uC0C1\uC5D0 \uC624\uC2E0
    \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4. \uC774 \uAC8C\uC784\uC5D0\uC11C
    \uC5EC\uB7EC\uBD84\uC758 \uBAA9\uD45C\uB294 \uC624\uC9C1 \uD558\uB098, \uC0DD\uC874\uC785\uB2C8\uB2E4.
    \uC6E8\uC774\uBE0C \uD615\uC2DD\uC73C\uB85C \uBAB0\uB824\uC624\uB294 \uC880\uBE44\uB4E4\uC744
    \uD53C\uD574 \uD0C8\uCD9C\uD558\uC138\uC694!\n\n\n\uC774\uB3D9: \uD0A4\uBCF4\uB4DC
    W, A, S, D \uD0A4\uB85C \uCE90\uB9AD\uD130\uB97C \uC774\uB3D9\uC2DC\uD0AC \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC2DC\uC810 \uC804\uD658: \uB9C8\uC6B0\uC2A4\uB97C
    \uC6C0\uC9C1\uC5EC \uC8FC\uBCC0\uC744 \uB458\uB7EC\uBCF4\uC138\uC694.\n\n\uACF5\uACA9:
    \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uD074\uB9AD\uC73C\uB85C \uBB34\uAE30\uB97C \uC0AC\uC6A9\uD574
    \uC880\uBE44\uB97C \uACF5\uACA9\uD569\uB2C8\uB2E4.\n\n\uC7AC\uC7A5\uC804: R \uD0A4\uB85C
    \uCD1D\uAE30\uB97C \uC7AC\uC7A5\uC804\uD558\uC138\uC694.\n\n\uC0C1\uC810 \uC5F4\uAE30:
    Tab \uD0A4\uB97C \uB20C\uB7EC \uC0C1\uC810 \uBA54\uB274\uB97C \uC5F4\uACE0 \uB2EB\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\n"
