--- !u!114 &994872213
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 994872211}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\uCCB4\uB825: \uD654\uBA74 \uC67C\uCABD \uD558\uB2E8\uC5D0 \uBCF4\uC774\uB294
    \uD558\uD2B8 \uC544\uC774\uCF58 \uC606 \uC22B\uC790\uB294 \uC5EC\uB7EC\uBD84\uC758
    \uD604\uC7AC \uCCB4\uB825\uC785\uB2C8\uB2E4. \uC880\uBE44\uC5D0\uAC8C \uACF5\uACA9\uB2F9\uD558\uBA74
    \uCCB4\uB825\uC774 \uC904\uC5B4\uB4E4\uACE0, \uCCB4\uB825\uC774 0\uC774 \uB418\uBA74
    \uAC8C\uC784\uC774 \uC885\uB8CC\uB429\uB2C8\uB2E4.\n\uD0C4\uC57D: \uD654\uBA74
    \uC624\uB978\uCABD \uC544\uB798\uC5D0 \uD604\uC7AC \uC0AC\uC6A9 \uC911\uC778
    \uCD1D\uAE30\uC758 \uB0A8\uC740 \uD0C4\uC57D\uC774 \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\n\n\uC880\uBE44\uB97C
    \uCC98\uCE58\uD558\uBA74 \uB3C8\uC744 \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uC774 \uB3C8\uC73C\uB85C \uC0C1\uC810\uC5D0\uC11C \uB2E4\uC591\uD55C \uC544\uC774\uD15C\uC744
    \uAD6C\uB9E4\uD574 \uC0DD\uC874 \uD655\uB960\uC744 \uB192\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD568\uC815
    \uBC0F \uC7A5\uC560\uBB3C \uC124\uCE58: \uC880\uBE44\uC758 \uC774\uB3D9 \uACBD\uB85C\uB97C
    \uB9C9\uAC70\uB098 \uD53C\uD574\uB97C \uC904 \uC218 \uC788\uB294 \uD568\uC815\uACFC
    \uC7A5\uC560\uBB3C\uC744 \uC124\uCE58\uD558\uC138\uC694.\n\uCD1D\uAE30 \uAD6C\uB9E4:
    \uB354\uC6B1 \uAC15\uB825\uD55C \uCD1D\uAE30\uB97C \uAD6C\uB9E4\uD558\uC5EC \uC880\uBE44\uB97C
    \uB9C9\uC73C\uC138\uC694\n\uC544\uC774\uD15C \uAD6C\uB9E4: \uD0C4\uC57D \uB610\uB294
    \uC774\uB3D9\uC18D\uB3C4 \uC99D\uAC00\uB4F1 \uC0C1\uD669\uC5D0 \uB9DE\uB294 \uC544\uC774\uD15C\uC744
    \uAD6C\uC785\uD574 \uC0DD\uC874\uD558\uC138\uC694\n\uC804\uB7B5\uC801\uC73C\uB85C
    \uB3C8\uC744 \uD65C\uC6A9\uD558\uC5EC \uB2E4\uC74C \uC6E8\uC774\uBE0C\uC5D0\uB300\uBE44\uD558\uB294
    \uAC83\uC774 \uC911\uC694\uD569\uB2C8\uB2E4!\n\n\n\uC124\uCE58: \uB9C8\uC6B0\uC2A4
    \uC67C\uCABD \uD074\uB9AD\uC73C\uB85C \uC124\uCE58 \uC544\uC774\uD15C(\uC7A5\uC560\uBB3C,
    \uD568\uC815 \uB4F1)\uC744 \uBC30\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD68C\uC804:
    \uB9C8\uC6B0\uC2A4 \uD720\uC744 \uB3CC\uB824 \uC124\uCE58\uD560 \uC544\uC774\uD15C\uC758
    \uBC29\uD5A5\uC744 \uD68C\uC804\uC2DC\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAC74\uCD95\uCDE8\uC18C:
    \uC124\uCE58 \uB3C4\uC911 ESC\uD0A4\uB97C \uB204\uB974\uBA74 \uAC74\uCD95\uC774
    \uCDE8\uC18C\uB429\uB2C8\uB2E4."
